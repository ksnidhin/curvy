# Copy this file to .env on your VPS and update the values

# ScraperAPI Key (for bypassing Amazon/Myntra bot protections)
SCRAPERAPI_KEY=your_scraper_api_key_here

# Groq API Key (for AI product detail extraction)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Personal Browser Session Cookies (to bypass anti-bot protections without proxy)
# You can also paste these directly in the Admin Panel without editing this file!
AMAZON_COOKIES=
MYNTRA_COOKIES=
FLIPKART_COOKIES=
AJIO_COOKIES=
MEESHO_COOKIES=
CUSTOM_COOKIES=
